# Reverse-proxy TLS automatique (Let's Encrypt) pour Deal Lomé.
# www → redirection vers le domaine apex.

www.deallome.com {
	redir https://deallome.com{uri} permanent
}

deallome.com {
	# Flux temps réel (SSE) : ni compression ni mise en tampon.
	@realtime path /api/realtime
	handle @realtime {
		reverse_proxy app:3000 {
			flush_interval -1
			header_down -Content-Encoding
		}
	}

	handle {
		encode gzip zstd
		reverse_proxy app:3000
	}
}
