rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Images publiques (logos de boutique, photos de produits) :
    // lecture publique, écriture par le propriétaire connecté.
    match /logos/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Photos produit (5 Mo) et vidéo de présentation (50 Mo, lot 6).
    match /products/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (
                     (request.resource.contentType.matches('image/.*')
                      && request.resource.size < 5 * 1024 * 1024)
                     || (request.resource.contentType.matches('video/mp4|video/webm|video/quicktime')
                         && request.resource.size < 50 * 1024 * 1024)
                   );
    }

    // Documents privés (pièces d'identité KYC, preuves de litige et de
    // livraison) : jamais lisibles côté client — ils sont consultés par le
    // serveur (SDK Admin). Écriture par le propriétaire connecté uniquement.
    match /kyc/{uid}/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024;
    }
    match /disputes/{uid}/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024;
    }
    match /proofs/{uid}/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // Pièces jointes de la messagerie (photos, PDF, messages vocaux) :
    // écrites par l'expéditeur, jamais lisibles côté client — consultation
    // via /api/messages/[id]/attachment, réservée aux deux parties de la
    // conversation et aux admins.
    match /chat/{uid}/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf|audio/.*');
    }

    // Tout le reste : refusé.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
